// Salon OS — multi-tenant schema
//
// Every tenant table carries an orgId and is protected by Postgres row-level
// security (ENABLE + FORCE), so a query with a missing or buggy org filter
// still cannot read another tenant's rows. The two exceptions are Membership
// and ApiKey, which are how a caller's org is discovered and therefore cannot
// be gated on already knowing it. `scripts/assert-rls.ts` enforces this in CI.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // In production (Neon/etc) DATABASE_URL is the pooled connection and
  // directUrl is the direct (non-pooled) connection used for migrations.
  directUrl = env("DIRECT_URL")
}

// ————————————————————————————————————————————————————————
// Tenancy & identity
// ————————————————————————————————————————————————————————

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  orderSeq  Int      @default(0) // per-org order number counter, bumped atomically in placeOrder
  saleSeq   Int      @default(0) // per-org customer-invoice counter, bumped atomically in recordSale
  currency  String   @default("INR") // ISO code used for all money display in this org
  /// GST registration number, printed on customer tax invoices.
  gstin     String?
  /// Registered legal name for the tax-invoice header (falls back to `name`).
  legalName String?
  createdAt DateTime @default(now())

  locations            Location[]
  memberships          Membership[]
  products             Product[]
  orders               Order[]
  authCodes            AuthorizationCode[]
  auditLog             AuditLogEntry[]
  movements            StockMovement[]
  addresses            Address[]
  apiKeys              ApiKey[]
  sales                Sale[]
  branchStock          BranchStock[]
  branchStockMovements BranchStockMovement[]
  invoiceSeries        InvoiceSeries[]
  saleReturns          SaleReturn[]
  customers            Customer[]
  staff                Staff[]
}

enum LocationType {
  BRANCH
  WAREHOUSE
}

model Location {
  id            String       @id @default(cuid())
  orgId         String
  org           Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  type          LocationType
  name          String
  isActive      Boolean      @default(true)
  /// Short code that starts this branch's invoice numbers, e.g. "ROS" →
  /// ROS/25-26/0001. Falls back to the first letters of the name.
  invoicePrefix String?

  memberships          Membership[]
  orders               Order[]
  addresses            Address[]
  branchStock          BranchStock[]
  branchStockMovements BranchStockMovement[]
  sales                Sale[]
  invoiceSeries        InvoiceSeries[]
  returns              SaleReturn[]
  staff                Staff[]

  @@index([orgId, type])
}

/// Per-branch, per-financial-year invoice counter. Indian practice is a
/// separate series per place of business that restarts each FY (1 Apr–31 Mar),
/// so GST returns can be filed series by series. One row per branch per FY;
/// `seq` is incremented atomically inside the sale transaction.
model InvoiceSeries {
  id       String   @id @default(cuid())
  orgId    String
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId String
  branch   Location @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Financial year label, e.g. "25-26".
  fy       String
  prefix   String
  seq      Int      @default(0)

  @@unique([branchId, fy])
  @@index([orgId])
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  phone              String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  memberships  Membership[]
  resetTokens  PasswordResetToken[]
  /// Their staff record, when they are also someone who can be credited
  /// with a sale. Managers and cashiers have one; a stylist has a Staff row
  /// with no User at all.
  staffProfile Staff?
}

// Shipping/delivery addresses. Scoped to an org; optionally pinned to a
// branch so a Purchase Manager manages their own branch's address book.
model Address {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  label       String // e.g. "Salon front desk", "Service entrance"
  contactName String?
  phone       String?
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  country     String    @default("India")
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([orgId, locationId])
}

enum Role {
  PURCHASE_MANAGER
  /// Salon counter staff: may sell and reprint their own bills, nothing else.
  SALON_STAFF
  WAREHOUSE_MANAGER
  SUPER_ADMIN
}

model Membership {
  id         String  @id @default(cuid())
  userId     String
  orgId      String
  role       Role
  locationId String? // required for PM/WM, null for SUPER_ADMIN

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, orgId]) // v1: one role per org per user
  @@index([orgId, role])
}

// ————————————————————————————————————————————————————————
// Catalogue & stock
// ————————————————————————————————————————————————————————

model Product {
  id               String  @id @default(cuid())
  orgId            String
  org              Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku              String
  name             String
  brand            String
  category         String
  unit             String
  stock            Int     @default(0)
  minStock         Int     @default(0)
  active           Boolean @default(true)
  imageUrl         String?
  /// Manufacturer barcode (EAN/UPC) as printed on the pack — what a counter
  /// scanner actually reads. Distinct from `sku`, which is our internal code.
  barcode          String?
  /// Bin/rack the product sits in inside the WAREHOUSE, e.g. "R3-B02". Used to
  /// sort the picking list. The salon's own shelf location is per-branch and
  /// lives on BranchStock.rackId instead.
  binLocation      String?
  /// Price the branch pays the warehouse (procurement cost), minor units.
  /// Doubles as the salon's cost basis when computing retail margin.
  priceCents       Int     @default(0)
  /// Price the salon charges the end customer, exclusive of GST, minor units.
  retailPriceCents Int     @default(0)
  /// GST rate charged to the customer, as a whole percent (0/5/12/18/28).
  gstRate          Int     @default(0)
  /// HSN code printed on the customer's tax invoice.
  hsn              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems           OrderItem[]
  movements            StockMovement[]
  cartItems            CartItem[]
  branchStock          BranchStock[]
  branchStockMovements BranchStockMovement[]
  saleItems            SaleItem[]
  returnItems          SaleReturnItem[]

  @@unique([orgId, sku])
  /// Nullable, so products without a barcode simply don't participate.
  @@unique([orgId, barcode])
  @@index([orgId, active, category])
}

model StockMovement {
  id        String  @id @default(cuid())
  orgId     String
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?

  prevQty    Int
  newQty     Int
  action     String
  refOrderId String?

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, productId])
}

// ————————————————————————————————————————————————————————
// Orders
// ————————————————————————————————————————————————————————

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_FULFILLED
  CANCELLED
  /// Warehouse declined the order before anything was dispatched.
  REJECTED
  /// Every delivered unit came back and was restocked.
  RETURNED
}

enum SaleStatus {
  COMPLETED
  /// Some units came back against the bill; the rest stand.
  PARTIALLY_RETURNED
  /// Every unit on the bill came back.
  RETURNED
  /// The bill was cancelled as an error; its stock was returned to the shelf.
  VOID
}

enum PaymentMode {
  CASH
  CARD
  UPI
}

// ————————————————————————————————————————————————————————
// Retail side: branch on-hand inventory and customer billing
// ————————————————————————————————————————————————————————

/// What a single branch currently holds on its shelf for one product. Topped
/// up when a warehouse dispatch is delivered, drawn down when sold to a
/// customer. Distinct from Product.stock, which is the warehouse's own stock.
/// What a branch is holding a given unit of stock FOR.
///
/// A salon buys one shampoo and uses it two ways: sealed bottles on the shelf
/// to sell, and opened ones at the back bar for washes. Those are the same
/// product but different money — retail is revenue, back bar is a cost of
/// delivering a service. Keeping them in one pool makes both the margin
/// reports and the reorder points wrong.
enum BranchStockKind {
  /// Sellable stock. The POS draws only from this.
  RETAIL
  /// Held for use during services. Never sold; reduced by hand when counted.
  SALON_USE
}

model BranchStock {
  id        String          @id @default(cuid())
  orgId     String
  org       Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Location        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Which pool this row counts. A branch can hold the same product in both,
  /// as two rows — hence `kind` being part of the unique key below.
  kind      BranchStockKind @default(RETAIL)
  onHand    Int             @default(0)
  /// Physical shelf/rack/bin label at this branch, e.g. "A-12" — helps staff
  /// find the product fast while billing. Per-branch (same product, different
  /// rack at another branch).
  rackId    String?
  updatedAt DateTime        @updatedAt

  /// Was [branchId, productId]. Adding `kind` is what lets one product sit in
  /// both pools at a branch; existing rows become RETAIL, which is what they
  /// already were in practice.
  @@unique([branchId, productId, kind])
  @@index([orgId, branchId])
  @@index([orgId, productId])
}

/// Append-only ledger of every change to a branch's on-hand stock, so a shelf
/// count can always be reconciled the same way warehouse stock can.
model BranchStockMovement {
  id        String          @id @default(cuid())
  orgId     String
  org       Org             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Location        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Which pool the movement came out of. Without this the ledger cannot say
  /// whether stock left the shelf or the back bar, and the two pools become
  /// impossible to reconcile after the fact.
  kind      BranchStockKind @default(RETAIL)
  userId    String?
  prevQty   Int
  newQty    Int
  /// "Delivery" | "Sale" | "Void sale" | "Return to warehouse" | "Adjustment"
  reason    String
  /// The order or sale that caused this movement, for traceability.
  refId     String?
  createdAt DateTime        @default(now())

  @@index([orgId, branchId, createdAt])
  @@index([orgId, productId])
}

/// A customer bill raised at a branch. GST is computed per line and summed;
/// prices and cost are snapshotted so later catalogue changes never rewrite
/// history. A VOID sale returns its units to the branch shelf.
/// A retail customer, identified by phone — the natural key in India, and the
/// only thing a walk-in reliably gives you.
///
/// Deliberately scoped to the ORG, not the branch: the same person visiting a
/// different salon must be the same customer, or the history is worthless the
/// moment a second branch opens.
model Customer {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Digits only, normalised on write, so lookup is exact regardless of how
  /// the cashier typed it (+91, spaces, dashes).
  phone     String
  name      String
  email     String?
  /// Free-text the counter can keep — allergies, preferred brand, and so on.
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([orgId, phone])
  @@index([orgId, name])
}

/// Someone who can be credited with a sale: a stylist, the manager, or the
/// counter staff.
///
/// Deliberately NOT the same thing as a User. Most stylists never sign into
/// this software — crediting them through a login account would mean inventing
/// an email and a password for every one of them, and creating a security
/// surface for people who have no reason to have one. An admin adds a stylist
/// by typing a name.
///
/// `userId` links the ones who DO sign in (managers, cashiers), so a person is
/// one record rather than two that have to be kept in step.
model Staff {
  id       String    @id @default(cuid())
  orgId    String
  org      Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// Which salon they work at. Null for someone who covers several.
  branchId String?
  branch   Location? @relation(fields: [branchId], references: [id])
  name     String
  /// Free text — "Senior Stylist", "Manager", "Counter". Display only; it
  /// grants nothing. Permissions live on Membership.role, and conflating the
  /// two would turn a label into an access-control decision.
  title    String?
  isActive Boolean   @default(true)
  /// Set only for staff who also have a login.
  userId   String?   @unique
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@index([orgId, branchId, isActive])
}

model Sale {
  id            String      @id @default(cuid())
  orgId         String
  org           Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Location    @relation(fields: [branchId], references: [id])
  /// Who bought. Null only when the cashier explicitly chose "walk-in" below.
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  /// True when the counter deliberately declined to record a customer.
  /// Kept as its own flag rather than inferring it from a null customerId, so
  /// "walk-in by choice" stays distinguishable from data that went missing —
  /// otherwise you can never tell a policy problem from a bug.
  isWalkIn      Boolean     @default(false)
  /// Sequence number within this branch+FY series.
  invoiceNo     Int
  /// The number as printed, e.g. "ROS/25-26/0001". Unique per org.
  invoiceCode   String
  /// Financial year the invoice belongs to, e.g. "25-26".
  fy            String
  soldByUserId  String
  customerName  String?
  customerPhone String?
  /// Buyer's GSTIN on a B2B sale, so they can claim input tax credit.
  buyerGstin    String?
  status        SaleStatus  @default(COMPLETED)
  paymentMode   PaymentMode @default(CASH)
  /// Sum of line taxable values AFTER discount (pre-GST), minor units.
  subtotalCents Int         @default(0)
  /// Total discount given across all lines (pre-GST), minor units.
  discountCents Int         @default(0)
  /// Total GST across all lines (CGST + SGST), minor units.
  taxCents      Int         @default(0)
  /// Signed adjustment (−49..+50 paise) that brings the bill to a whole rupee,
  /// as is conventional on Indian invoices.
  roundOffCents Int         @default(0)
  /// subtotal + tax + roundOff, minor units — what the customer pays.
  totalCents    Int         @default(0)
  /// Sum of procurement cost of the units sold, minor units — for margin.
  costCents     Int         @default(0)
  voidReason    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items   SaleItem[]
  returns SaleReturn[]

  @@unique([orgId, invoiceCode])
  @@index([orgId, branchId, createdAt])
  @@index([orgId, status])
}

/// A customer bringing goods back against a bill. Unlike a void (which cancels
/// the whole bill as an error), a return is partial-by-default and keeps the
/// original invoice intact — the returned units go back on the shelf and a
/// credit note is raised for the refunded value.
model SaleReturn {
  id              String      @id @default(cuid())
  orgId           String
  org             Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Location    @relation(fields: [branchId], references: [id])
  saleId          String
  sale            Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  /// Credit-note number, e.g. "CN/ROS/25-26/0003".
  creditNoteCode  String
  reason          String
  note            String?
  /// How the money went back to the customer.
  refundMode      PaymentMode @default(CASH)
  subtotalCents   Int         @default(0)
  taxCents        Int         @default(0)
  totalCents      Int         @default(0)
  createdByUserId String
  createdAt       DateTime    @default(now())

  items SaleReturnItem[]

  @@unique([orgId, creditNoteCode])
  @@index([orgId, branchId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id             String     @id @default(cuid())
  returnId       String
  saleReturn     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  /// The bill line being returned against.
  saleItemId     String
  saleItem       SaleItem   @relation(fields: [saleItemId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  qty            Int
  /// Value refunded for this line, mirroring the original line's maths.
  lineNetCents   Int
  taxCents       Int
  lineTotalCents Int

  @@index([returnId])
  @@index([saleItemId])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  /// Snapshots taken at sale time.
  name           String
  hsn            String?
  qty            Int
  /// Retail unit price, exclusive of GST, minor units.
  unitPriceCents Int
  gstRate        Int
  /// Discount given on this line, pre-GST, minor units. Indian GST is charged
  /// on the discounted value, so this reduces the taxable amount.
  discountCents  Int     @default(0)
  /// (qty × unitPriceCents) − discountCents — the taxable value, minor units.
  lineNetCents   Int
  /// GST on this line (CGST + SGST together), minor units.
  taxCents       Int
  /// lineNetCents + taxCents, minor units.
  lineTotalCents Int
  /// Procurement unit cost snapshot, minor units — for margin reporting.
  unitCostCents  Int     @default(0)
  /// Units the customer has brought back against this line.
  returnedQty    Int     @default(0)
  /// Which staff member is credited with this line — the person responsible
  /// for the sale, which is not necessarily whoever operated the till. Null
  /// means the counter itself: a walk-in nobody in particular is owed credit
  /// for. Never printed on the customer's invoice; this is internal
  /// attribution for commission and reporting.
  ///
  /// Held at line grain even though the counter currently picks one person for
  /// the whole bill and every line is written with that value. Crediting
  /// individual products to different staff is a UI change from here; had this
  /// lived on Sale instead it would be a migration of history that cannot be
  /// reconstructed.
  staffId        String?
  staff          Staff?  @relation(fields: [staffId], references: [id])

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Order {
  id              String             @id @default(cuid())
  orgId           String
  org             Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderNo         Int
  branchId        String
  branch          Location           @relation(fields: [branchId], references: [id])
  placedByUserId  String
  status          OrderStatus        @default(PENDING)
  authCodeId      String?
  authCode        AuthorizationCode? @relation(fields: [authCodeId], references: [id])
  shipToAddressId String?
  shipToAddress   Address?           @relation(fields: [shipToAddressId], references: [id])
  deliveryNote    String?
  /// Order value at the time it was placed (sum of item qty × unit price), in minor units.
  /// Re-computed when a Purchase Manager edits a still-PENDING order.
  totalCents      Int                @default(0)
  /// Why the order ended the way it did — set when the warehouse rejects it or
  /// accepts a return. Free-form label from OUTSTANDING/REJECTION/RETURN_REASONS.
  closureReason   String?
  closureNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([orgId, orderNo])
  @@index([orgId, branchId, status])
  @@index([orgId, status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  requestedQty   Int
  /// Net units the branch currently holds: dispatched − returned.
  deliveredQty   Int     @default(0)
  /// Cumulative units sent back to the warehouse and restocked.
  returnedQty    Int     @default(0)
  note           String?
  /// Price snapshot at order time — catalogue prices may change later.
  unitPriceCents Int     @default(0)

  outstandingReason String?
  outstandingEta    DateTime?
  outstandingRemark String?

  deliveries OrderItemDelivery[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemDelivery {
  id                 String    @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// Always positive; read together with `kind`.
  qty                Int
  /// "DISPATCH" (warehouse → branch) or "RETURN" (branch → warehouse).
  kind               String    @default("DISPATCH")
  dispatchedByUserId String?
  createdAt          DateTime  @default(now())

  @@index([orderItemId])
}

// DB-backed cart: survives refresh/re-login, one draft cart per user per org.
model CartItem {
  id        String  @id @default(cuid())
  orgId     String
  userId    String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId, productId])
  @@index([orgId, userId])
}

// ————————————————————————————————————————————————————————
// Authorization codes & audit
// ————————————————————————————————————————————————————————

model AuthorizationCode {
  id              String    @id @default(cuid())
  orgId           String
  org             Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  locationId      String? // null = org-wide code; set = branch-scoped
  codeHash        String
  label           String? // e.g. last 4 chars for display, "ROSE-****"
  isActive        Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  rotatedAt       DateTime?

  orders Order[]

  @@index([orgId, isActive])
}

// Machine-to-machine access for the versioned REST API (integrations,
// reporting tools, ERP sync). The raw key is shown once at creation; only
// its hash is stored. `prefix` (first 8 chars) enables fast lookup + display.
model ApiKey {
  id              String    @id @default(cuid())
  orgId           String
  org             Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  prefix          String    @unique
  keyHash         String
  createdByUserId String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId])
}

/// One-time tokens for "set your password" (invite) and "reset your password".
/// Only a SHA-256 hash is stored, so a database leak cannot be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("reset") // "reset" | "invite"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLogEntry {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String?
  userName   String? // denormalized for display even if user is later removed
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}
